# Groq Cloud API key — used for LLM generation (llama-3.1-8b-instant)
GROQ_API_KEY=your_groq_api_key_here

# Sarvam AI API key — used for saaras:v3 speech-to-text
SARVAM_API_KEY=your_sarvam_api_key_here

# Hugging Face token — optional, only needed for gated/rate-limited dataset access
HF_TOKEN=your_hf_token_here

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Post-retrieval grounding guardrail: minimum cosine similarity to accept context
EMBEDDING_SIMILARITY_THRESHOLD=0.38

# Circuit breaker timeout for the LLM harness, in milliseconds
LLM_TIMEOUT_MS=150
