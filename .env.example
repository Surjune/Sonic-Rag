# Groq Cloud API key — LLM generation, and the Whisper speech fallback
GROQ_API_KEY=your_groq_api_key_here
# Optional spare key. Free-tier quota is per-key, so a second one recovers
# from a 429 that switching vendors cannot. Rotation triggers on 401, 403
# and 429 only. Use UPPERCASE: Linux environment variables are
# case-sensitive, so GROQ_API_KEY_Backup would be ignored on a host.
GROQ_API_KEY_BACKUP=

# Sarvam AI API key — saaras:v3 speech-to-text and mayura:v1 translation
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_API_KEY_BACKUP=

# Hugging Face token — optional, only needed for gated/rate-limited dataset access
HF_TOKEN=your_hf_token_here

# Generation backend: "groq" (default) or "ollama".
#
# Groq is the deployment target -- it needs no local GPU and runs on hardware
# no laptop matches. "ollama" points the same harness at a model running on
# this machine, to measure what removing the network round trip actually buys.
# It is a measurement tool, not a deployment path: the model that fits a
# laptop GPU is far smaller than the one Groq serves.
LLM_PROVIDER=groq
OLLAMA_API_URL=http://localhost:11434/v1/chat/completions
OLLAMA_MODEL=llama3.2:3b
# How long Ollama keeps the weights in VRAM after the last request. Its own
# default is 5 minutes, after which the next question pays a full reload --
# 8155ms cold against 22ms warm, which looks like a random glitch.
OLLAMA_KEEP_ALIVE=30m

# Speech output (Sarvam bulbul). Uses SARVAM_API_KEY above -- no extra key.
# The counterpart to speech input: a question asked by voice can be answered by
# voice. Synthesis is per-request and opt-in, so a typed question costs nothing.
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Post-retrieval grounding guardrail: minimum cosine similarity to accept context
EMBEDDING_SIMILARITY_THRESHOLD=0.68

# Circuit breaker timeout for the LLM harness, in milliseconds
LLM_TIMEOUT_MS=700
