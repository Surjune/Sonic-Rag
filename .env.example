# Groq Cloud API key — LLM generation, and the Whisper speech fallback
GROQ_API_KEY=your_groq_api_key_here
# Optional spare key. Free-tier quota is per-key, so a second one recovers
# from a 429 that switching vendors cannot. Rotation triggers on 401, 403
# and 429 only. Use UPPERCASE: Linux environment variables are
# case-sensitive, so GROQ_API_KEY_Backup would be ignored on a host.
GROQ_API_KEY_BACKUP=

# Sarvam AI API key — saaras:v3 speech-to-text and mayura:v1 translation
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_API_KEY_BACKUP=

# Hugging Face token — optional, only needed for gated/rate-limited dataset access
HF_TOKEN=your_hf_token_here

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Post-retrieval grounding guardrail: minimum cosine similarity to accept context
EMBEDDING_SIMILARITY_THRESHOLD=0.68

# Circuit breaker timeout for the LLM harness, in milliseconds
LLM_TIMEOUT_MS=150
